# Copy this to  ~/.snalbum-draftsync/config  and  chmod 600  it.
# That file holds your band password, so it lives outside the repo and is
# readable only by you. draftsync.py reads it on every run.

BAND=dando
BAND_PASS=replace-with-your-band-password
WATCH_DIR=/Users/bunj/Music/SnAlbum drafts

# --- optional, sensible defaults shown ---
# FOLDER_NAME=Recently uploaded
# MAX_MB=50
# STABLE_SECONDS=10
