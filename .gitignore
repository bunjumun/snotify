.DS_Store

# Audio lives in Supabase Storage now (index.html reads it from the 'tracks' bucket) —
# nothing under tracks/ needs to be committed or exposed via the repo/GitHub Pages.
tracks/**/*.wav
tracks/**/*.aif
tracks/**/*.aiff
tracks/**/*.flac
tracks/**/*.m4a
tracks/**/*.mp3
tracks/**/*.ogg

# Trash: deleted songs archived locally until permanently removed via the player
.trash/

# The change request ledger stays local by decision — rough thinking, not shared
# work product. The notebook it tracks is an Apple Note and was never in here.
# Consequence worth knowing: a fresh clone starts with no ledger at all.
change requests/
